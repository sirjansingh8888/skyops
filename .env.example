# Copy to .env (never commit .env).
# Assistant: free Gemini API key from https://aistudio.google.com/apikey (steps in HANDOFF.md)
GEMINI_API_KEY=

# SkyOps runtime settings (all optional)
SKYOPS_HOST=127.0.0.1
SKYOPS_PORT=8000
# inference device: auto (CUDA when PyTorch sees a GPU, else CPU), cpu, or cuda
SKYOPS_DEVICE=auto
# starting YOLO weights; models/visdrone_yolo.pt is used automatically once it exists
SKYOPS_YOLO_WEIGHTS=yolov8n.pt
SKYOPS_ASSISTANT_PROVIDER=gemini
# gemini-3.6-flash was the fastest reliable free-tier model in our tests (~10 s per question);
# the newest Flash models were overloaded on the free tier. Try them again on the day.
SKYOPS_GEMINI_MODEL=gemini-3.6-flash
SKYOPS_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
SKYOPS_GEMINI_TIMEOUT_S=25
# Optional alternative provider: pip install anthropic, set SKYOPS_ASSISTANT_PROVIDER=claude and ANTHROPIC_API_KEY=...

# Replay a different recording (output of scripts/record_opensky.py); default is the organisers' capture
# SKYOPS_OPENSKY_CSV=data/raw/opensky/recorded_YYYYMMDD_HHMM.csv
# Optional OpenSky API client (https://opensky-network.org -> Account -> API client) for higher live-feed limits
# SKYOPS_OPENSKY_CLIENT_ID=
# SKYOPS_OPENSKY_CLIENT_SECRET=
SKYOPS_LIVE_INTERVAL_S=30
