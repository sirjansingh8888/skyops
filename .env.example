# Copy to .env (never commit .env). The Anthropic SDK reads ANTHROPIC_API_KEY directly.
ANTHROPIC_API_KEY=sk-ant-...

# SkyOps runtime settings (all optional)
SKYOPS_HOST=127.0.0.1
SKYOPS_PORT=8000
# "cpu" on a laptop without CUDA, "cuda" on the RTX laptop
SKYOPS_DEVICE=cpu
# starting YOLO weights; models/visdrone_yolo.pt is used automatically once it exists
SKYOPS_YOLO_WEIGHTS=yolov8n.pt
SKYOPS_ASSISTANT_MODEL=claude-opus-5
